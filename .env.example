# LegiScan API key (optional, for state legislation tracking)
# Get a free key at https://legiscan.com/legiscan
# LEGISCAN_API_KEY=your_key_here

# Firecrawl API key (optional, server only). Ask Medina uses the keyless
# Firecrawl gov search by default; set this for higher rate limits.
# FIRECRAWL_API_KEY=fc-your_key_here

# Seed fake sample data into an empty database (development only)
# SEED_SAMPLE_DATA=1
